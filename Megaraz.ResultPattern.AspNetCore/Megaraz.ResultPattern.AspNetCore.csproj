<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Megaraz.ResultPattern.AspNetCore</PackageId>
    <Version>0.1.3</Version>
    <Title>Megaraz Result Pattern ASP.NET Core</Title>
    <Description>ASP.NET Core and HTTP extensions for Megaraz.ResultPattern.</Description>
    <Authors>Megaraz</Authors>
    <Copyright>Copyright (c) 2026 Megaraz</Copyright>
    <RepositoryUrl>https://github.com/Megaraz/Megaraz.ResultPattern.AspNetCore</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Megaraz/Megaraz.ResultPattern.AspNetCore</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>result;result-pattern;errors;validation;aspnetcore;http</PackageTags>
    <PackageReleaseNotes>0.1.3: Hardens the release supply chain with CodeQL, dependency review, NuGet Dependabot updates, secret scanning push protection, and protected release checks.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.403" PrivateAssets="All" />
    <PackageReference Include="Megaraz.ResultPattern" Version="0.2.2" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
